{
  "redirects": [
    { "source": "/page.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/page" },
    { "source": "/index.html", "destination": "/api/page" },
    { "source": "/download", "destination": "/api/download" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "page.html" }
  }
}
